# ==========================================
# I Sports Game Guide - Production Environment (.env)
# Domain: https://aviatorgameguide.com
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_USER="isports_user"
POSTGRES_PASSWORD="ChangeThisToAStrongPassword123!"
POSTGRES_DB="isports_db"

# Internal Docker Database URL (app connects to db container)
DATABASE_URL="postgresql://isports_user:ChangeThisToAStrongPassword123!@db:5432/isports_db?schema=public"

# If running Prisma migrations from host machine without docker:
# DATABASE_URL="postgresql://isports_user:ChangeThisToAStrongPassword123!@localhost:5436/isports_db?schema=public"

# Public Site & Auth URLs
NEXT_PUBLIC_SITE_URL="https://aviatorgameguide.com"
NEXTAUTH_URL="https://aviatorgameguide.com"
AUTH_URL="https://aviatorgameguide.com"
AUTH_TRUST_HOST="true"

# NextAuth v5 Secret Key (generate via: openssl rand -base64 32)
AUTH_SECRET="e9f4560b299e9021669466ebbcdaff3081e6992dcbce75657064c12bbd63eb3a"

# Node Environment
# Host Port mapping for reverse proxy
APP_PORT=3005
