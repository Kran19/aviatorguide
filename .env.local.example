# ==========================================
# I Sports Game Guide - Local Development (.env.local)
# ==========================================

# Local Postgres Database URL
DATABASE_URL="postgresql://isports_user:isports_local_password@localhost:5436/isports_db?schema=public"

POSTGRES_USER="isports_user"
POSTGRES_PASSWORD="isports_local_password"
POSTGRES_DB="isports_db"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_SECRET="local-development-secret-key-32-chars-long"

NODE_ENV="development"
PORT=3000
